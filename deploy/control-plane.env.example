# Copy to /etc/cod/control-plane.env and replace every placeholder on the server.
# Never commit the populated file.
DATABASE_URL=postgresql://cod:replace-me@127.0.0.1:5432/cod
COD_SESSION_SECRET=replace-with-at-least-32-random-bytes
COD_PILOT_ACCESS_CODE_HASH=replace-with-sha256-hex
# Non-secret policy such as allowed origins and the registration switch lives in
# runtime.env; systemd loads it after this file so secret-file drift cannot reopen features.
# Registration requires both email and SMS OTP verification.
# For a controlled internal beta only, set COD_REGISTRATION_VERIFICATION_REQUIRED=false
# in runtime.env. Never use the bypass for a public launch.
# Exactly 32 random bytes. Prefix canonical encodings with base64: or base64url:.
# COD_REGISTRATION_HMAC_KEY=base64url:replace-with-32-random-bytes
# COD_REGISTRATION_EMAIL_WEBHOOK_URL=https://messaging.example.internal/cod/email
# COD_REGISTRATION_EMAIL_WEBHOOK_TOKEN=replace-with-email-webhook-bearer-token
# COD_REGISTRATION_SMS_WEBHOOK_URL=https://messaging.example.internal/cod/sms
# COD_REGISTRATION_SMS_WEBHOOK_TOKEN=replace-with-sms-webhook-bearer-token
# COD_TURNSTILE_SITE_KEY=replace-with-public-site-key
# COD_TURNSTILE_SECRET_KEY=replace-with-secret-key
# Turnstile verify endpoint. Production must use challenges.cloudflare.com.
# COD_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Hostnames allowed to render the Turnstile widget (the public pages that host
# the registration form). Production registration REQUIRES this list to be set.
# COD_TURNSTILE_EXPECTED_HOSTNAMES=cod.kai.com
# The two Turnstile actions. Must stay exactly these two values in production.
# COD_TURNSTILE_EXPECTED_ACTIONS=cod_registration_email,cod_registration_phone
# Outbound hostnames the control plane may contact for OTP delivery webhooks.
# Production registration REQUIRES this list to be set; it is the allowlist that
# gates egress for both the email and SMS webhooks. List every webhook hostname.
# COD_REGISTRATION_OUTBOUND_ALLOWED_HOSTS=messaging.example.internal
# OTP lifetime, resend policy, limits, and public URL are configured in runtime.env.

# Model providers
KAI_API_KEY=replace-with-server-side-provider-key
# All team.kai.com Token retail aliases share the ai.kai.com upstream.
# Production KAI endpoints must use HTTPS and one of these exact hostnames.
# KAI_AI_ALLOWED_HOSTS=ai.kai.com
# Client-selectable source aliases are non-financial. Keep this at zero until
# attribution is bound to an authenticated account/channel on the server.
# TOKEN_RETAIL_COMMISSION_RATE_BPS=0

# KAI Wiki
# KAI_WIKI_SEARCH_ENDPOINT=/api/search
# KAI_WIKI_API_KEY=replace-with-wiki-key

# Official merchant payments. Enable either complete group or both; partial groups fail startup.
# COD_PAYMENT_PUBLIC_BASE_URL=https://cod.kai.com
# COD_WECHAT_PAY_MCH_ID=replace-with-merchant-id
# COD_WECHAT_PAY_APP_ID=replace-with-app-id
# COD_WECHAT_PAY_SERIAL_NO=replace-with-merchant-certificate-serial
# COD_WECHAT_PAY_PRIVATE_KEY_PATH=/etc/cod/secrets/wechat-merchant-private-key.pem
# COD_WECHAT_PAY_API_V3_KEY=replace-with-exactly-32-bytes
# COD_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=/etc/cod/secrets/wechat-platform-public-key.pem
# COD_WECHAT_PAY_PLATFORM_SERIAL_NO=replace-with-platform-certificate-serial
# COD_ALIPAY_APP_ID=replace-with-app-id
# COD_ALIPAY_SELLER_ID=replace-with-2088-seller-id
# COD_ALIPAY_PRIVATE_KEY_PATH=/etc/cod/secrets/alipay-merchant-private-key.pem
# COD_ALIPAY_PUBLIC_KEY_PATH=/etc/cod/secrets/alipay-public-key.pem
# COD_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# Optional normalized callback retained for a separately trusted adapter.
# COD_PAYMENT_WEBHOOK_SECRET=replace-with-payment-adapter-secret
# Opens only the Compute Market discovery shell. Transaction, hosting, asset,
# content and admin capabilities remain fail-closed until their real adapters
# are connected; review fixtures are never enabled in production.
COD_COMPUTE_MARKET_ENABLED=false

# Feishu application bot. Binding keys are "tenant_key:open_id".
# COD_FEISHU_VERIFICATION_TOKEN=replace-with-verification-token
# COD_FEISHU_ENCRYPT_KEY=replace-with-encrypt-key
# COD_FEISHU_APP_ID=cli_replace-me
# COD_FEISHU_APP_SECRET=replace-with-app-secret
# COD_FEISHU_BINDINGS_JSON={"tenant_key:open_id":"developer@kai.com"}

# Hong Kong signed launch
# KAI_HONGKONG_SSO_SECRET=replace-with-shared-sso-secret
