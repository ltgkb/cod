NODE_ENV=production
COD_ALLOWED_EMAIL_DOMAINS=kai.com,163.com,126.com,gmail.com,qq.com,vn.com
COD_ALLOWED_ORIGINS=https://cod.kai.com,https://localhost,capacitor://localhost,null
# Registration fails closed until both real delivery providers and Turnstile are
# configured in /etc/cod/control-plane.env and smoke-tested.
COD_REGISTRATION_ENABLED=false
COD_INVITE_CODE_REQUIRED=false
COD_PUBLIC_REGISTRATION_URL=https://cod.kai.com/app/?auth=register
COD_REGISTRATION_OTP_TTL_SECONDS=600
COD_REGISTRATION_RESEND_SECONDS=60
COD_REGISTRATION_MAX_SENDS_PER_CHANNEL=3
COD_REGISTRATION_MAX_FAILED_ATTEMPTS=5
COD_DEVELOPMENT_LOGIN_ENABLED=true
COD_DEVELOPMENT_LOGIN_EMAIL=developer@kai.com
COD_DEVELOPMENT_TOPUP_ENABLED=false
COD_DEMO_MODE=false
