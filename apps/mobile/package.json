{
  "name": "@cod/mobile",
  "version": "0.2.0",
  "private": true,
  "description": "COD Expo mobile application",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export": "expo export --platform all --output-dir release/export",
    "export:android": "expo export --platform android --output-dir release/android",
    "export:ios": "expo export --platform ios --output-dir release/ios",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/native-back.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "expo": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.1",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
