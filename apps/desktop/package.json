{
  "name": "@cod/desktop",
  "version": "0.1.3",
  "private": true,
  "description": "COD cross-platform agent workspace",
  "desktopName": "cod.desktop",
  "homepage": "https://kai.com/cod",
  "author": {
    "name": "KAI",
    "email": "support@kai.com"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "predev": "npm run build",
    "dev": "node scripts/dev.mjs",
    "verify:dev": "npm run build && node scripts/dev.mjs --smoke",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare:sidecar": "node scripts/prepare-goose-sidecar.mjs",
    "package:linux": "npm run build -w @cod/web && npm run build && node scripts/prepare-goose-sidecar.mjs --platform=linux --arch=x64 && electron-builder --linux AppImage deb --x64",
    "package:mac": "npm run build -w @cod/web && npm run build && node scripts/prepare-goose-sidecar.mjs --platform=darwin && CSC_FOR_PULL_REQUEST=true CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip -c.mac.identity=-",
    "package:mac:signed": "npm run build -w @cod/web && npm run build && node scripts/prepare-goose-sidecar.mjs --platform=darwin && electron-builder --mac dmg zip",
    "package:win": "npm run build -w @cod/web && npm run build && node scripts/prepare-goose-sidecar.mjs --platform=win32 --arch=x64 && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@cod/contracts": "*",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "8.18.1",
    "concurrently": "^9.2.1",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.kai.cod",
    "productName": "COD",
    "executableName": "cod",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/desktop-pet/app.asar",
        "to": "desktop-pet/app.asar"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "syncDesktopName": true,
      "category": "Development",
      "maintainer": "KAI <support@kai.com>",
      "synopsis": "COD agent workspace",
      "artifactName": "COD-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "artifactName": "COD-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            },
            "localhost": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "COD-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
