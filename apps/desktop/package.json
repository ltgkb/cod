{
  "name": "@cod/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "COD cross-platform agent workspace",
  "homepage": "https://kai.com/cod",
  "author": {
    "name": "KAI",
    "email": "support@kai.com"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @cod/web\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:linux": "npm run build -w @cod/web && npm run build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@cod/contracts": "*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "concurrently": "^9.2.1",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.kai.cod",
    "productName": "COD",
    "executableName": "cod",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "protocols": [
      {
        "name": "COD Protocol",
        "schemes": ["cod"]
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "KAI <support@kai.com>",
      "synopsis": "COD agent workspace",
      "artifactName": "COD-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    }
  }
}
