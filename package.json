{
  "name": "cod",
  "version": "0.1.0",
  "private": true,
  "description": "COD agent workspace",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cod/web",
    "build": "npm run build -w @cod/web && npm run build -w @cod/desktop",
    "typecheck": "npm run typecheck -w @cod/web && npm run typecheck -w @cod/desktop",
    "test": "npm run test -w @cod/web",
    "lint": "npm run lint -w @cod/web",
    "desktop": "npm run dev -w @cod/desktop",
    "package:linux": "npm run package:linux -w @cod/desktop"
  },
  "engines": {
    "node": ">=22"
  }
}
